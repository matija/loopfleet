{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "loopfleet",
  "version": "0.1.6",
  "identifier": "com.loopfleet.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "cwd": "../frontend",
      "script": "npm run dev"
    },
    "beforeBuildCommand": {
      "cwd": "../frontend",
      "script": "npm run build"
    }
  },
  "app": {
    "windows": [
      {
        "title": "loopfleet",
        "width": 1200,
        "height": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3MDJCNTJGRTlGNzgyNTMKUldSVGd2ZnBMN1VDdDJCTDF3SDVvTWJ0UXNzQ2xpWE1IakZrTDBOWTlGUjg5c2hybG5rUytidTQK",
      "endpoints": [
        "https://github.com/matija/loopfleet/releases/latest/download/latest.json"
      ]
    }
  }
}
